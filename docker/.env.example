# Example .env.local file for Docker Compose setup
# Copy this file to the root directory as .env.local and adjust the values

# Database Configuration
POSTGRES_USER=sentio_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentio_db

# Authentication
AUTH_SECRET=generate_a_random_secret_key_here

# Application URL
PUBLIC_APP_URL=http://localhost:8080

# Optional: Email Configuration (for verification emails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@example.com
