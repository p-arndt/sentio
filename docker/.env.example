PUBLIC_ALLOW_SIGNUP="false"  # Set to "true" to enable user registration

BETTER_AUTH_SECRET=your-super-secret-key-32-characters-min
BETTER_AUTH_URL=http://localhost:3000

# Auth Provider Configuration
# Options: 'email' (default), 'oidc'
AUTH_PROVIDER=email

# Email/Password Auth
# By default, email auth is enabled even with OIDC provider
# This ensures users can accept invitations via registration link
# Set to 'true' to disable ONLY if you don't use invitation links
# EMAIL_AUTH_DISABLED=false

# OIDC Provider Configuration (required if AUTH_PROVIDER=oidc)
# Works with any OIDC-compliant provider including:
# - Azure Entra ID / Microsoft (use Azure discovery endpoint)
# - Keycloak
# - Auth0
# - Any other OIDC provider

# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://your-oidc-provider.com

# Example for Azure:
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0

POSTGRES_HOST=localhost
POSTGRES_USER=sentio
POSTGRES_PASSWORD=sentio
POSTGRES_DB=sentio

# Optional: SMTP / Email Configuration
# You can set SMTP values here to provide defaults if no values are stored in the database.
# If values are provided in the UI they will be persisted to the DB and override these env values.
# Example:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com