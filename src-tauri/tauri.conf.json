{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Sentio",
    "version": "0.10.2",
    "identifier": "de.sentio.app",
    "build": {
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "pnpm run dev",
        "beforeBuildCommand": "svelte-kit sync && TAURI_PLATFORM=desktop vite build --config vite.config.tauri.ts",
        "frontendDist": "../build/client"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Sentio",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            },
            {
                "label": "notification",
                "url": "/notification",
                "title": "Notification",
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visible": false,
                "resizable": false,
                "fullscreen": false,
                "skipTaskbar": true,
                "focus": false,
                "shadow": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "shell": {
            "all": false,
            "open": true
        }
    }
}